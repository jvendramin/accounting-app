# Neon Postgres pooled connection string
DATABASE_URL=postgresql://neondb_owner:...@ep-...-pooler.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Neon Auth — Better Auth REST endpoint (`*.neonauth.*/neondb/auth`)
NEXT_PUBLIC_NEON_AUTH_URL=https://ep-....neonauth.aws.neon.tech/neondb/auth

# S3-compatible object storage for receipts (Backblaze B2 in this app)
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=
S3_BUCKET=
S3_ENDPOINT=
